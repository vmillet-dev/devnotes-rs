{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "devnotes",
  "identifier": "com.devnotes.app",
  "build": {
    "beforeDevCommand": "npm run start",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist/devnotes/browser"
  },
  "app": {
    "windows": [
      {
        "title": "devnotes",
        "width": 1100,
        "height": 720,
        "minWidth": 640,
        "minHeight": 480,
        "visible": false,
        "backgroundColor": "#15171c"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-ancestors 'none'",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": {
      "resources/identity/": "identity/"
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZBMjJGNDA1RkVGMEEzNkYKUldSdm8vRCtCZlFpK3IzSFdQSFZ0YlM3VTh5eXNpVDhueWp2SzNPYyt6VmVHQVJ6eWs1ZDBzeE4K",
      "endpoints": ["https://github.com/vmillet-dev/devnotes-rs/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
