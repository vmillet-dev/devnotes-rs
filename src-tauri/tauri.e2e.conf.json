{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "com.devnotes.app.e2e",
  "build": {
    "beforeBuildCommand": "npm run build:e2e"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "capabilities": [
        "default",
        {
          "identifier": "e2e",
          "description": "The WebDriver harness. Declared inline so no file under capabilities/ can reach a release build.",
          "windows": ["main"],
          "permissions": ["wdio:default", "wdio-webdriver:default", "core:window:allow-set-focus"]
        }
      ]
    }
  }
}
