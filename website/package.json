{
  "name": "devnotes-website",
  "version": "0.0.0",
  "description": "The showcase site and documentation of DevNotes, devnotes.fr",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vmillet-dev/devnotes-rs.git",
    "directory": "website"
  },
  "private": true,
  "scripts": {
    "ng": "ng",
    "docs": "node scripts/docs.mjs",
    "start": "npm run docs && ng serve",
    "build": "npm run docs && node scripts/fetch-release.mjs && ng build && node scripts/finish-build.mjs",
    "test": "npm run docs && ng test",
    "test:scripts": "node --test scripts/docs.test.mjs scripts/palette.test.mjs scripts/tokens.test.mjs",
    "lint": "npm run docs && eslint ."
  },
  "dependencies": {
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/platform-server": "^22.3.0",
    "@angular/router": "^22.3.0",
    "@angular/ssr": "^22.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "@eslint/js": "10.0.1",
    "angular-eslint": "22.8.0",
    "eslint": "10.15.0",
    "jsdom": "^30.1.1",
    "marked": "18.2.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "^4.1.10"
  }
}
