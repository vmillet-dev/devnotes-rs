    subgraph core["engine : Arc#lt;Engine#gt;"]
      db["Db = Mutex#lt;Option#lt;Library#gt;#gt;"]
      idx["NoteIndex (entrées Arc immuables)"]
      net["Sending · Runs · Sockets · Restored"]
    end
    core -->|"EngineEvent via EventSink"| chan["canal d'événements"]
