# See https://docs.github.com/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# Compiled output
/dist
/tmp
/out-tsc
/bazel-out

# Node
/node_modules
npm-debug.log
yarn-error.log

# IDEs and editors
.vscode/
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# Miscellaneous
/.angular/cache
.sass-cache/
/connect.lock
/coverage
/e2e/logs
/libpeerconnection.log
testem.log
/typings
# Claude Code: skills and rules are versioned, local state is not.
.claude/*
!.claude/skills/
!.claude/rules/

# Signature — clés privées de l'updater et certificats de signature de code.
# Filet de sécurité : ces fichiers vivent normalement hors du dépôt.
*.key
*.pfx
.tauri/

# System files
.DS_Store
Thumbs.db
